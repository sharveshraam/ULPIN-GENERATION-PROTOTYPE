# Example environment for the ULPIN FastAPI backend.
# Copy to .env for local development. NEVER commit a real .env.
# On Render, set these in Dashboard -> Environment instead.
#
# Every value below has a working default — the app runs with none of them set.

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Render injects PORT automatically; do not hard-code it in production.
# HOST must stay 0.0.0.0 so the service is reachable outside the container.
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# CORS — the frontend is hosted separately from the backend
# ---------------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
#
#   "*"  = any origin. Convenient for a hackathon demo. Credentials are
#          automatically disabled in this mode, because browsers reject
#          "Access-Control-Allow-Origin: *" on credentialed requests.
#
# For production, list explicit origins instead, e.g.
#   ALLOWED_ORIGINS=https://yourname.github.io,https://ulpin.example.com
# Local development origins are appended automatically in that case.
ALLOWED_ORIGINS=*

# Optional override of the auto-added local dev origins.
# DEV_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite by default. NOTE: Render's filesystem is EPHEMERAL — data written here
# is lost on every redeploy, restart or instance move. Fine for a demo; for
# persistence attach a Render Disk or switch to Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/ulpin
# (Postgres additionally requires the "psycopg[binary]" package.)
DATABASE_URL=sqlite:///./ulpin_database.db

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="ULPIN Generation API"
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# OpenStreetMap services (free, no API key required)
# ---------------------------------------------------------------------------
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSM policy requires a descriptive User-Agent identifying your app.
USER_AGENT=ULPIN-Generator/1.0 (hackathon prototype)

HTTP_TIMEOUT=90
MAX_RADIUS_KM=5
MAX_BUILDINGS_PER_REQUEST=5000

# ---------------------------------------------------------------------------
# Rate limiting (in-process, per instance)
# ---------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_S=60

# Tall towers imply tens of thousands of units; cap what is written to the DB.
PERSIST_UNITS_LIMIT=4000
