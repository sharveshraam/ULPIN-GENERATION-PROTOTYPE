# Copy to .env and adjust. All values have working defaults.

APP_NAME="ULPIN Generation API"
LOG_LEVEL=INFO

# SQLite by default; swap for Postgres in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/ulpin
DATABASE_URL=sqlite:///./ulpin_database.db

# Comma-separated origins, or * for any.
CORS_ORIGINS=*

# OpenStreetMap services (free, no key required).
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSM policy requires a descriptive User-Agent with contact info.
USER_AGENT=ULPIN-Generator/1.0 (hackathon prototype)

HTTP_TIMEOUT=90
MAX_RADIUS_KM=5
MAX_BUILDINGS_PER_REQUEST=5000

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_S=60

# Tall towers imply tens of thousands of units; cap what we write to the DB.
PERSIST_UNITS_LIMIT=4000
